filters:
  and:
    - file.path != this.file.path
formulas:
  TagLink: list([this.file.tags, this.file.links.map("#" + value.replace(/\[\[(.+?)\|.*/, "$1"))]).flat().filter(list([file.tags, file.links.map("#" + value.replace(/\[\[(.+?)\|.*/, "$1"))]).flat().containsAny(value)).unique().length + if(file.ctime.format("YYMMDD")==this.file.ctime.format("YYMMDD"),3,0)
  Color: if(formula.TagLink>2, "🔵️", if(formula.TagLink>1, "🟢️", "🟡️"))
properties:
  file.name:
    displayName: 関連ノート
  formula.Color:
    displayName: .
views:
  - type: table
    name: TagLink
    filters:
      and:
        - formula.TagLink > 0
    order:
      - formula.Color
      - file.name
    sort:
      - property: formula.TagLink
        direction: DESC
      - property: file.ctime
        direction: DESC
    limit: 50
    columnSize:
      formula.Color: 30
