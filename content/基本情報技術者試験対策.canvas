			"id":"d85b4a76a7589bd8",
			"type":"text",
			"text":"```dataviewjs\n// ▼▼ 設定エリア ▼▼\n// 集計したい「フォルダ名」または「タグ」を指定してください\n// 例: '\"勉強/情報システム\"' または '\"#学習用\"' (ダブルクォーテーションを忘れずに！)\nconst query = '\"000_Publish/02.Study/基本情報技術者試験/科目B\"';\n// ▲▲ 設定エリア終了 ▲▲\n\n// 1. 対象のページをすべて取得\nconst pages = dv.pages(query);\n\n// 2. 全ファイルのテキストを並列で読み込む (高速化)\nconst paths = pages.map(p => p.file.path).array();\nconst contents = await Promise.all(paths.map(path => dv.io.load(path)));\n\n// 3. 全ファイル分をまとめて正規表現チェック\nconst regex = /^\\s*(?:[-*+]|\\d+\\.)\\s*\\[(\\s|x|X)\\]/gm;\n\nlet total = 0;\nlet completed = 0;\n\n// 読み込んだ各ファイルの中身をループ処理\ncontents.forEach(content => {\n    // コンテンツが空(null)の場合はスキップ\n    if (!content) return;\n\n    const matches = content.match(regex);\n    if (matches) {\n        total += matches.length;\n        matches.forEach(m => {\n            if (m.includes(\"[x]\") || m.includes(\"[X]\")) {\n                completed++;\n            }\n        });\n    }\n});\n\n// 進捗率計算\nconst progress = total === 0 ? 0 : Math.round((completed / total) * 100);\nconst incomplete = total - completed;\n\n// 4. グラフ描画\nconst chartData = {\n    type: 'doughnut',\n    data: {\n        labels: ['完了 (' + completed + ')', '未完了 (' + incomplete + ')'],\n        datasets: [{\n            label: '全体進捗',\n            data: [completed, incomplete],\n            backgroundColor: ['rgba(75, 192, 192, 0.6)', 'rgba(255, 99, 132, 0.6)'],\n            borderColor: ['rgba(75, 192, 192, 1)', 'rgba(255, 99, 132, 1)'],\n            borderWidth: 1\n        }]\n    },\n    options: {\n        responsive: true,\n        maintainAspectRatio: false,\n        plugins: {\n            legend: { position: 'bottom' },\n            title: {\n                display: true,\n                // ファイル数も表示するようにしました\n                text: `全体進捗 (${pages.length}ノート): ${progress}% (${completed}/${total})`,\n                font: { size: 16 }\n            }\n        }\n    }\n};\n\nwindow.renderChart(chartData, this.container);\nthis.container.style.height = \"300px\";\n```\n",
			"styleAttributes":{},
			"x":720,
			"y":640,
			"width":460,
			"height":400,
			"color":"3"
		},
		{
			"id":"b6fa3a067c686218",
			"type":"text",
			"text":"```dataviewjs\n// ▼▼ 設定エリア ▼▼\n// 集計したいノートのファイル名（拡張子.mdは不要）を入力してください\nconst targetFileName = \"セクション2：準備\";\n// ▲▲ 設定エリア終了 ▲▲\n\n// 1. ファイル情報の取得\nconst page = dv.page(targetFileName);\n\nif (!page) {\n    dv.paragraph(`❌ エラー: \"${targetFileName}\" というノートが見つかりません。ファイル名が正しいか確認してください。`);\n} else {\n    // 2. そのファイルの「生のテキストデータ」を読み込む\n    // page.file.path で正確なパス（フォルダ/ファイル名.md）を取得して読み込みます\n    const content = await dv.io.load(page.file.path);\n\n    // 3. 正規表現でチェックボックスを集計\n    // (箇条書き「-」や番号付き「1.」の後の [ ] [x] をすべて拾います)\n    const regex = /^\\s*(?:[-*+]|\\d+\\.)\\s*\\[(\\s|x|X)\\]/gm;\n\n    let total = 0;\n    let completed = 0;\n\n    const matches = content.match(regex);\n\n    if (matches) {\n        total = matches.length;\n        matches.forEach(m => {\n            if (m.includes(\"[x]\") || m.includes(\"[X]\")) {\n                completed++;\n            }\n        });\n    }\n\n    // 進捗率計算\n    const progress = total === 0 ? 0 : Math.round((completed / total) * 100);\n    const incomplete = total - completed;\n\n    // 4. グラフ描画\n    const chartData = {\n        type: 'doughnut',\n        data: {\n            labels: ['完了 (' + completed + ')', '未完了 (' + incomplete + ')'],\n            datasets: [{\n                label: 'タスク状況',\n                data: [completed, incomplete],\n                backgroundColor: ['rgba(75, 192, 192, 0.6)', 'rgba(255, 99, 132, 0.6)'],\n                borderColor: ['rgba(75, 192, 192, 1)', 'rgba(255, 99, 132, 1)'],\n                borderWidth: 1\n            }]\n        },\n        options: {\n            responsive: true,\n            maintainAspectRatio: false,\n            plugins: {\n                legend: { position: 'bottom' },\n                title: {\n                    display: true,\n                    // タイトルにファイル名も含めるようにしました\n                    text: targetFileName + ': ' + progress + '% (' + completed + '/' + total + ')',\n                    font: { size: 16 }\n                }\n            }\n        }\n    };\n\n    window.renderChart(chartData, this.container);\n    this.container.style.height = \"300px\";\n}\n```\n",
			"styleAttributes":{},
			"x":720,
			"y":1040,
			"width":460,
			"height":400
		},
