{
	"nodes":[
		{"id":"6f6d00e34b38c9ae","type":"group","x":700,"y":-1100,"width":1900,"height":1660,"color":"5","label":"基本情報技術者試験科目A"},
		{"id":"a3511d4527ab0e08","type":"group","x":700,"y":620,"width":1880,"height":1640,"color":"6","label":"基本情報技術者試験科目B"},
		{
			"id":"d70b47adf4fbfa0f",
			"type":"text",
			"text":"```dataviewjs\n// ▼▼ 設定エリア ▼▼\n// 集計したいノートのファイル名（拡張子.mdは不要）を入力してください\nconst targetFileName = \"セクション2：情報システム開発\";\n// ▲▲ 設定エリア終了 ▲▲\n\n// 1. ファイル情報の取得\nconst page = dv.page(targetFileName);\n\nif (!page) {\n    dv.paragraph(`❌ エラー: \"${targetFileName}\" というノートが見つかりません。ファイル名が正しいか確認してください。`);\n} else {\n    // 2. そのファイルの「生のテキストデータ」を読み込む\n    // page.file.path で正確なパス（フォルダ/ファイル名.md）を取得して読み込みます\n    const content = await dv.io.load(page.file.path);\n\n    // 3. 正規表現でチェックボックスを集計\n    // (箇条書き「-」や番号付き「1.」の後の [ ] [x] をすべて拾います)\n    const regex = /^\\s*(?:[-*+]|\\d+\\.)\\s*\\[(\\s|x|X)\\]/gm;\n\n    let total = 0;\n    let completed = 0;\n\n    const matches = content.match(regex);\n\n    if (matches) {\n        total = matches.length;\n        matches.forEach(m => {\n            if (m.includes(\"[x]\") || m.includes(\"[X]\")) {\n                completed++;\n            }\n        });\n    }\n\n    // 進捗率計算\n    const progress = total === 0 ? 0 : Math.round((completed / total) * 100);\n    const incomplete = total - completed;\n\n    // 4. グラフ描画\n    const chartData = {\n        type: 'doughnut',\n        data: {\n            labels: ['完了 (' + completed + ')', '未完了 (' + incomplete + ')'],\n            datasets: [{\n                label: 'タスク状況',\n                data: [completed, incomplete],\n                backgroundColor: ['rgba(75, 192, 192, 0.6)', 'rgba(255, 99, 132, 0.6)'],\n                borderColor: ['rgba(75, 192, 192, 1)', 'rgba(255, 99, 132, 1)'],\n                borderWidth: 1\n            }]\n        },\n        options: {\n            responsive: true,\n            maintainAspectRatio: false,\n            plugins: {\n                legend: { position: 'bottom' },\n                title: {\n                    display: true,\n                    // タイトルにファイル名も含めるようにしました\n                    text: targetFileName + ': ' + progress + '% (' + completed + '/' + total + ')',\n                    font: { size: 16 }\n                }\n            }\n        }\n    };\n\n    window.renderChart(chartData, this.container);\n    this.container.style.height = \"300px\";\n}\n```\n",
			"styleAttributes":{},
			"x":720,
			"y":-680,
			"width":460,
			"height":400
		},
		{
			"id":"4a427296b2b8618b",
			"type":"text",
			"text":"```dataviewjs\n// ▼▼ 設定エリア ▼▼\n// 集計したいノートのファイル名（拡張子.mdは不要）を入力してください\nconst targetFileName = \"セクション3：プロジェクトマネジメント\";\n// ▲▲ 設定エリア終了 ▲▲\n\n// 1. ファイル情報の取得\nconst page = dv.page(targetFileName);\n\nif (!page) {\n    dv.paragraph(`❌ エラー: \"${targetFileName}\" というノートが見つかりません。ファイル名が正しいか確認してください。`);\n} else {\n    // 2. そのファイルの「生のテキストデータ」を読み込む\n    // page.file.path で正確なパス（フォルダ/ファイル名.md）を取得して読み込みます\n    const content = await dv.io.load(page.file.path);\n\n    // 3. 正規表現でチェックボックスを集計\n    // (箇条書き「-」や番号付き「1.」の後の [ ] [x] をすべて拾います)\n    const regex = /^\\s*(?:[-*+]|\\d+\\.)\\s*\\[(\\s|x|X)\\]/gm;\n\n    let total = 0;\n    let completed = 0;\n\n    const matches = content.match(regex);\n\n    if (matches) {\n        total = matches.length;\n        matches.forEach(m => {\n            if (m.includes(\"[x]\") || m.includes(\"[X]\")) {\n                completed++;\n            }\n        });\n    }\n\n    // 進捗率計算\n    const progress = total === 0 ? 0 : Math.round((completed / total) * 100);\n    const incomplete = total - completed;\n\n    // 4. グラフ描画\n    const chartData = {\n        type: 'doughnut',\n        data: {\n            labels: ['完了 (' + completed + ')', '未完了 (' + incomplete + ')'],\n            datasets: [{\n                label: 'タスク状況',\n                data: [completed, incomplete],\n                backgroundColor: ['rgba(75, 192, 192, 0.6)', 'rgba(255, 99, 132, 0.6)'],\n                borderColor: ['rgba(75, 192, 192, 1)', 'rgba(255, 99, 132, 1)'],\n                borderWidth: 1\n            }]\n        },\n        options: {\n            responsive: true,\n            maintainAspectRatio: false,\n            plugins: {\n                legend: { position: 'bottom' },\n                title: {\n                    display: true,\n                    // タイトルにファイル名も含めるようにしました\n                    text: targetFileName + ': ' + progress + '% (' + completed + '/' + total + ')',\n                    font: { size: 16 }\n                }\n            }\n        }\n    };\n\n    window.renderChart(chartData, this.container);\n    this.container.style.height = \"300px\";\n}\n```\n",
